    "dev": "node scripts/startDev.js",
    "test:phase1": "node scripts/verifyPhase1.js",
    "test:roles": "node scripts/testRoleVisibility.js",
    "test:phase2": "node scripts/testPhase2.js",
    "test:phase3": "node scripts/testPhase3.js",
    "test:phase4": "node scripts/testPhase4.js"
  },
  "keywords": [
